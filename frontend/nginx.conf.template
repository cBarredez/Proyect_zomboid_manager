server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Matched before the generic /api/ block below (nginx picks the longest
    # matching prefix) since SSE needs buffering disabled — nginx buffers
    # proxied responses by default, which silently holds back every chunk of
    # a text/event-stream response until the connection closes, so the log
    # stream (and this panel's console drawer) would never show anything live.
    location /api/logs/stream {
        proxy_pass http://${PZ_MANAGER_API_BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
    }

    location /api/ {
        proxy_pass http://${PZ_MANAGER_API_BACKEND};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri /index.html;
    }
}
